# Runtime generated data — never commit contents, but keep the dir (.gitkeep)
# so a fresh clone self-creates the write targets weewx/PHP need
serverdata/*
!serverdata/.gitkeep
jsondata/

# jsondata exception — static lookup table must be tracked
!jsondata/lookupTable.json

# Highcharts runtime data — track the dir (.gitkeep), ignore the generated json
w34highcharts/json/*
!w34highcharts/json/.gitkeep
w34highcharts/json_day/*
!w34highcharts/json_day/.gitkeep
w34highcharts/w34_reports/__pycache__/

# Station-specific config — never commit
scripts/w34config.py
settings1.php
CLAUDE.md

# (all icon sets are now tracked)

# Log files and scratch files
*.log
*.bak
placeholder.txt
_config.yml
pop_metoffice_daynight.php-not*
w34highcharts/*.html-org
modules.php
